{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "sourceLocale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "locales": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      }
    },
    "history": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "limit"
      ],
      "additionalProperties": false
    },
    "visuals": {
      "type": "object",
      "properties": {
        "themes": {
          "type": "string",
          "enum": [
            "both",
            "dark",
            "light"
          ]
        },
        "preset": {
          "type": "string",
          "const": "quiet-product"
        },
        "width": {
          "type": "integer",
          "minimum": 256,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 256,
          "maximum": 4096
        },
        "accent": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "dark": {
          "type": "object",
          "properties": {
            "canvas": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            },
            "raised": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            },
            "primary": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            },
            "secondary": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            },
            "divider": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            }
          },
          "required": [
            "canvas",
            "surface",
            "raised",
            "primary",
            "secondary",
            "divider"
          ],
          "additionalProperties": false
        },
        "light": {
          "type": "object",
          "properties": {
            "canvas": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            },
            "raised": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            },
            "primary": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            },
            "secondary": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            },
            "divider": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            }
          },
          "required": [
            "canvas",
            "surface",
            "raised",
            "primary",
            "secondary",
            "divider"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "themes",
        "preset",
        "width",
        "height",
        "accent",
        "dark",
        "light"
      ],
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "codex",
          "claude",
          "cursor"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "product",
    "sourceLocale",
    "locales",
    "history",
    "visuals",
    "tools"
  ],
  "additionalProperties": false,
  "$id": "urn:releasekit:config:1"
}
