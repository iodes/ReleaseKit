{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "sourceLocale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "locales": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      }
    },
    "history": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "start": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "sha": {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                },
                "past": {
                  "type": "string",
                  "const": "summary"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]{0,95}$"
                }
              },
              "required": [
                "ref",
                "sha",
                "past",
                "version"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "sha": {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                },
                "past": {
                  "type": "string",
                  "const": "history"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]{0,95}$"
                }
              },
              "required": [
                "ref",
                "sha",
                "past",
                "version"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "sha": {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                },
                "past": {
                  "type": "string",
                  "const": "skip"
                },
                "version": {
                  "type": "null"
                }
              },
              "required": [
                "ref",
                "sha",
                "past",
                "version"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "limit"
      ],
      "additionalProperties": false
    },
    "visuals": {
      "type": "object",
      "properties": {
        "themes": {
          "type": "string",
          "enum": [
            "both",
            "dark",
            "light"
          ]
        },
        "preset": {
          "type": "string",
          "const": "quiet-product"
        },
        "width": {
          "type": "integer",
          "minimum": 256,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 256,
          "maximum": 4096
        },
        "accent": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "dark": {
          "type": "object",
          "properties": {
            "canvas": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$",
              "description": "Uniform illustration background."
            },
            "surface": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$",
              "description": "Base or recessed interface panels."
            },
            "raised": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$",
              "description": "Foreground panels, controls, and quiet tile fills."
            },
            "primary": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$",
              "description": "Main neutral glyphs, focal controls, and feature-defining marks; mid-gray in the default light theme."
            },
            "secondary": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$",
              "description": "Supporting glyphs, incidental label bars, and abstract content."
            },
            "divider": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$",
              "description": "Thin separators and necessary surface boundaries."
            }
          },
          "required": [
            "canvas",
            "surface",
            "raised",
            "primary",
            "secondary",
            "divider"
          ],
          "additionalProperties": false
        },
        "light": {
          "type": "object",
          "properties": {
            "canvas": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$",
              "description": "Uniform illustration background."
            },
            "surface": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$",
              "description": "Base or recessed interface panels."
            },
            "raised": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$",
              "description": "Foreground panels, controls, and quiet tile fills."
            },
            "primary": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$",
              "description": "Main neutral glyphs, focal controls, and feature-defining marks; mid-gray in the default light theme."
            },
            "secondary": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$",
              "description": "Supporting glyphs, incidental label bars, and abstract content."
            },
            "divider": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$",
              "description": "Thin separators and necessary surface boundaries."
            }
          },
          "required": [
            "canvas",
            "surface",
            "raised",
            "primary",
            "secondary",
            "divider"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "themes",
        "preset",
        "width",
        "height",
        "accent",
        "dark",
        "light"
      ],
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "codex",
          "claude",
          "cursor"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "product",
    "sourceLocale",
    "locales",
    "history",
    "visuals",
    "tools"
  ],
  "additionalProperties": false,
  "$id": "urn:releasekit:config:1"
}
